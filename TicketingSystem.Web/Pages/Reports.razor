@page "/reports"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Reports</PageTitle>

<div class="reports-page">
    <h1>Reports & Statistics</h1>

    <div class="filter-bar">
        <input type="date" @bind="_fromDate" placeholder="From" />
        <input type="date" @bind="_toDate" placeholder="To" />
        <button class="btn btn-primary" @onclick="LoadAllReports">Apply</button>
    </div>

    <div class="tabs">
        <button class="@(_activeTab == 0 ? "active" : "")" @onclick="() => _activeTab = 0">Status Distribution</button>
        <button class="@(_activeTab == 1 ? "active" : "")" @onclick="() => _activeTab = 1">Priority Distribution</button>
        <button class="@(_activeTab == 2 ? "active" : "")" @onclick="() => _activeTab = 2">Avg Processing Time</button>
        <button class="@(_activeTab == 3 ? "active" : "")" @onclick="() => _activeTab = 3">Most Active Systems</button>
        <button class="@(_activeTab == 4 ? "active" : "")" @onclick="() => _activeTab = 4">Full Report</button>
    </div>

    @if (_activeTab == 0)
    {
        <div class="table-container">
            <table>
                <thead><tr><th>Status</th><th>Count</th></tr></thead>
                <tbody>
                    @foreach (var item in (_statusDist ?? new List<StatusDistributionDto>()))
                    {
                        <tr><td>@item.StatusName</td><td>@item.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_activeTab == 1)
    {
        <div class="table-container">
            <table>
                <thead><tr><th>Priority</th><th>Count</th></tr></thead>
                <tbody>
                    @foreach (var item in (_priorityDist ?? new List<PriorityDistributionDto>()))
                    {
                        <tr><td>@item.PriorityName</td><td>@item.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_activeTab == 2)
    {
        <div class="table-container"><p>Average processing time: @_avgProcessingTime hours</p></div>
    }

    @if (_activeTab == 3)
    {
        <div class="table-container">
            <table>
                <thead><tr><th>System</th><th>Ticket Count</th></tr></thead>
                <tbody>
                    @foreach (var item in (_systemStats ?? new List<SystemStatsDto>()))
                    {
                        <tr><td>@item.SystemName</td><td>@item.TicketCount</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_activeTab == 4)
    {
        <div class="table-container">
            <button class="btn btn-primary" @onclick="ExportFullReport">Export PDF</button>
        </div>
    }
</div>

@code {
    private int _activeTab = 0;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<StatusDistributionDto>? _statusDist;
    private List<PriorityDistributionDto>? _priorityDist;
    private List<SystemStatsDto> _systemStats = new();
    private double _avgProcessingTime = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllReports();
    }

    private async Task LoadAllReports()
    {
        var query = "?from=" + _fromDate?.ToString("yyyy-MM-dd") + "&to=" + _toDate?.ToString("yyyy-MM-dd");
        _statusDist = await ApiClient.GetStatusDistributionAsync(query);
        _priorityDist = await ApiClient.GetPriorityDistributionAsync(query);
            }

    private void ExportFullReport() { /* TODO */ }
}
