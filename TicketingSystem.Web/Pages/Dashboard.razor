@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <h1>Dashboard</h1>

    <div class="stats-grid">
        <div class="stat-card stat-open">
            <h3>@(_stats?.OpenCount ?? 0)</h3>
            <p>Open Tickets</p>
        </div>
        <div class="stat-card stat-progress">
            <h3>@(_stats?.InProgressCount ?? 0)</h3>
            <p>In Progress</p>
        </div>
        <div class="stat-card stat-resolved">
            <h3>@(_stats?.ResolvedCount ?? 0)</h3>
            <p>Resolved</p>
        </div>
        <div class="stat-card stat-closed">
            <h3>@(_stats?.ClosedCount ?? 0)</h3>
            <p>Closed</p>
        </div>
    </div>

    <div class="recent-section">
        <h2>Recent Tickets</h2>
        <table>
            <thead>
                <tr><th>Ticket #</th><th>Title</th><th>Status</th><th>Priority</th><th>Date</th></tr>
            </thead>
            <tbody>
                @foreach (var ticket in (_recentTickets ?? new List<TicketDto>()).Take(10))
                {
                    <tr @onclick="@(() => GoToTicket(ticket.TicketId))" class="clickable">
                        <td class="ticket-number">@ticket.TicketNumber</td>
                        <td>@ticket.Title</td>
                        <td>@ticket.StatusName</td>
                        <td>@ticket.PriorityName</td>
                        <td>@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private DashboardStats? _stats;
    private List<TicketDto>? _recentTickets;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _stats = await ApiClient.GetDashboardStatsAsync();
        _recentTickets = (await ApiClient.GetTicketsAsync(new FilterRequest { StatusId = 1, PageSize = 10 }));
    }

    private void GoToTicket(int id)
    {
        Navigation.NavigateTo("/tickets/" + id);
    }
}
