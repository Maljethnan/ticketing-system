@page "/tickets"
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Tickets</PageTitle>

<div class="tickets-page">
    <div class="page-header">
        <h1>Tickets</h1>
        <button class="btn btn-primary" @onclick="GoToCreate">+ New Ticket</button>
    </div>

    <div class="filter-bar">
        <input type="text" @bind="_filter.Search" placeholder="Search..." class="search-input" />
        <select @bind="_filter.StatusId" class="filter-select">
            <option value="">All Statuses</option>
            <option value="1">Open</option>
            <option value="2">Assigned</option>
            <option value="3">In Progress</option>
            <option value="4">Resolved</option>
            <option value="5">Closed</option>
        </select>
        <select @bind="_filter.PriorityId" class="filter-select">
            <option value="">All Priorities</option>
            <option value="1">Critical</option>
            <option value="2">High</option>
            <option value="3">Medium</option>
            <option value="4">Low</option>
        </select>
        <button class="btn btn-primary" @onclick="LoadTickets">Filter</button>
    </div>

    <table class="tickets-table">
        <thead>
            <tr><th>#</th><th>Title</th><th>System</th><th>Status</th><th>Priority</th><th>Created</th><th>Assignee</th></tr>
        </thead>
        <tbody>
            @if (_tickets == null || !_tickets.Any())
            {
                <tr><td colspan="7" class="empty-state">No matching tickets</td></tr>
            }
            else
            {
                @foreach (var ticket in _tickets)
                {
                    <tr @onclick="@(() => GoToTicket(ticket.TicketId))" class="clickable">
                        <td class="ticket-number">@ticket.TicketNumber</td>
                        <td>@ticket.Title</td>
                        <td>@ticket.SystemName</td>
                        <td>@ticket.StatusName</td>
                        <td>@ticket.PriorityName</td>
                        <td>@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@ticket.AssigneeName</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="() => ChangePage(-1)" disabled="@(_filter.Page <= 1)">Prev</button>
        <span>Page @_filter.Page</span>
        <button @onclick="() => ChangePage(1)">Next</button>
    </div>
</div>

@code {
    private FilterRequest _filter = new();
    private List<TicketDto>? _tickets;

    protected override async Task OnInitializedAsync()
    {
        await LoadTickets();
    }

    private async Task LoadTickets()
    {
        var result = await ApiClient.GetTicketsAsync(_filter);
        _tickets = result;
    }

    private async Task ChangePage(int delta)
    {
        _filter = new FilterRequest
        {
            Search = _filter.Search,
            SystemId = _filter.SystemId,
            StatusId = _filter.StatusId,
            PriorityId = _filter.PriorityId,
            FromDate = _filter.FromDate,
            ToDate = _filter.ToDate,
            Page = _filter.Page + delta,
            PageSize = _filter.PageSize
        };
        await LoadTickets();
    }

    private void GoToTicket(int id)
    {
        Navigation.NavigateTo("/tickets/" + id);
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/tickets/create");
    }
}
