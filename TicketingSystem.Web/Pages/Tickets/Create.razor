@page "/tickets/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiClient ApiClient
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<PageTitle>Create Ticket</PageTitle>

<div class="create-ticket-page">
    <h1>Create New Ticket</h1>

    <EditForm Model="_ticket" OnValidSubmit="@HandleSubmit">
        <div class="form-row">
            <div class="form-group">
                <label>Title</label>
                <InputText @bind-Value="_ticket.Title" class="form-control" />
            </div>
            <div class="form-group">
                <label>System</label>
                <InputSelect @bind-Value="_ticket.SystemId" class="form-control">
                    <option value="">-- Select --</option>
                    @foreach (var sys in _systems)
                    {
                        <option value="@sys.Id">@sys.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Priority</label>
                <InputSelect @bind-Value="_ticket.Priority" class="form-control">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label>Category</label>
                <InputSelect @bind-Value="_ticket.CategoryId" class="form-control">
                    <option value="">-- Select --</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-group full-width">
            <label>Description</label>
            <textarea @bind="_ticket.Description" rows="6" class="form-control"></textarea>
        </div>

        <div class="form-group full-width">
            <label>Attachments</label>
            <input type="file" multiple @onchange="OnFileSelected" class="file-input" />
            @if (_files.Count > 0)
            {
                <div class="file-list">
                    @foreach (var file in _files)
                    {
                        <div class="file-item">
                            <span>@file.FileName (@FormatFileSize(file.Length))</span>
                            <button type="button" class="remove-file" @onclick="@(() => RemoveFile(file))">X</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-outline" @onclick="GoBack">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@_loading">
                @(_loading ? "Submitting..." : "Submit")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private CreateTicketDto _ticket = new();
    private List<IFormFile> _files = new();
    private List<SystemDto> _systems = new();
    private List<CategoryDto> _categories = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _systems = await ApiClient.GetSystemsAsync();
        _categories = await ApiClient.GetCategoriesAsync();
    }

    private async Task HandleSubmit()
    {
        try
        {
            _loading = true;
            await ApiClient.CreateTicketAsync(_ticket);
            Navigation.NavigateTo("/tickets");
        }
        catch (Exception) { /* Show error */ }
        finally { _loading = false; }
    }

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        var browserFiles = e.Value as IBrowserFile[];
        if (browserFiles != null)
        {
            foreach (var bf in browserFiles)
            {
                using var stream = bf.OpenReadStream(long.MaxValue);
                var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                _files.Add(new FormFile(ms, 0, ms.Length, bf.Name, bf.Name));
            }
        }
    }

    private void RemoveFile(IFormFile file) => _files.Remove(file);

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / (1024.0 * 1024)).ToString("F1") + " MB";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/tickets");
    }
}
