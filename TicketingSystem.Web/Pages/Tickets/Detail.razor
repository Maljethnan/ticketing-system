@page "/tickets/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiClient ApiClient
@inject AuthService AuthService
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<PageTitle>Ticket Details</PageTitle>

<div class="detail-page">
    @if (_ticket == null)
    {
        <div class="not-found">
            <h2>Ticket not found</h2>
            <a href="/tickets" class="btn btn-outline">Back</a>
        </div>
    }
    else
    {
        <div class="ticket-header">
            <h1>@_ticket.TicketNumber - @_ticket.Title</h1>
            <span class="badge badge-@GetStatusClass(_ticket.StatusName)">@_ticket.StatusName</span>
        </div>

        <div class="ticket-details">
            <div class="detail-grid">
                <div><strong>System:</strong> @_ticket.SystemName</div>
                <div><strong>Priority:</strong> @_ticket.PriorityName</div>
                <div><strong>Created:</strong> @_ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                <div><strong>Reporter:</strong> @_ticket.ReporterName</div>
                <div><strong>Assignee:</strong> @_ticket.AssigneeName</div>
            </div>

            <section class="description-section">
                <h3>Description</h3>
                <p>@_ticket.Description</p>
            </section>

            <section class="attachments-section">
                <h3>Attachments</h3>
                @if (_ticket.Attachments?.Any() == true)
                {
                    @foreach (var att in _ticket.Attachments)
                    {
                        <a href="#" class="attachment-link">@att.FileName (@FormatFileSize(att.FileSizeBytes))</a>
                    }
                }
                else
                {
                    <p>No attachments</p>
                }
            </section>

            <section class="comments-section">
                <h3>Comments</h3>
                @if (_comments?.Any() == true)
                {
                    @foreach (var comment in _comments)
                    {
                        <div class="comment-card">
                            <div class="comment-meta">@comment.AuthorName - @comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            <p>@comment.Text</p>
                        </div>
                    }
                }
                else
                {
                    <p>No comments yet</p>
                }

                <div class="add-comment">
                    <textarea @bind="_newComment" rows="3" placeholder="Write a comment..."></textarea>
                    <button class="btn btn-primary" @onclick="AddComment">Send</button>
                </div>
            </section>

            @if (_isCreator)
            {
                <section class="actions-section">
                    @if (_ticket.StatusName == "Resolved")
                    {
                        <button class="btn btn-success" @onclick="ApproveClosure">Approve Closure</button>
                        <button class="btn btn-warning" @onclick="ReopenTicket">Reopen</button>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TicketDto? _ticket;
    private List<CommentDto>? _comments;
    private string _newComment = "";
    private bool _isCreator;
    private string _reopenReason = "";

    protected override async Task OnInitializedAsync()
    {
        _ticket = await ApiClient.GetTicketAsync(Id);
        _comments = await ApiClient.GetCommentsAsync(Id);
        var currentUser = await AuthService.GetCurrentUserAsync();
        _isCreator = _ticket?.CreatedBy == currentUser?.UserId;
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        await ApiClient.AddCommentAsync(Id, _newComment);
        _newComment = "";
        _comments = await ApiClient.GetCommentsAsync(Id);
    }

    private async Task ApproveClosure()
    {
        await ApiClient.ApproveClosureAsync(Id);
        _ticket = await ApiClient.GetTicketAsync(Id);
    }

    private async Task ReopenTicket()
    {
        await ApiClient.ReopenTicketAsync(Id, _reopenReason);
        _ticket = await ApiClient.GetTicketAsync(Id);
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / (1024.0 * 1024)).ToString("F1") + " MB";
    }

    private string GetStatusClass(string s) => s switch
    {
        "Open" => "open",
        "Assigned" => "assigned",
        "In Progress" => "progress",
        "Resolved" => "resolved",
        "Closed" => "closed",
        "Reopened" => "reopened",
        _ => "open"
    };
}
